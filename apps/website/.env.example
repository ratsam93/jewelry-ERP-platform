# Marketing site (static export): these are inlined at build time.
# Base URL of the CaratFlow API (must allow this site's origin via CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Tenant that receives contact enquiries and newsletter signups.
NEXT_PUBLIC_TENANT_ID=69544f8e-fa3c-40b4-8975-643825600ce7
# Public URL of this site (used for sitemap, robots and og:image).
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Optional social profile URLs; icons are hidden when unset.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
