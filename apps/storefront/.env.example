# Storefront (Next.js) public environment. Copy to apps/storefront/.env.local to override.

# API origin (the NestJS API listens on API_PORT, default 4000).
# Fallback in code: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Tenant the storefront reads from (sent as x-tenant-id).
# Fallback in code: seeded demo tenant 69544f8e-fa3c-40b4-8975-643825600ce7.
# Tenant ids differ per database; set this to your tenant's id after seeding.
NEXT_PUBLIC_TENANT_ID=69544f8e-fa3c-40b4-8975-643825600ce7

# Tenant slug used by auth/register flows. Fallback in code: sharma-jewellers.
NEXT_PUBLIC_TENANT_SLUG=sharma-jewellers

# Extra image hosts allowed by next/image (comma-separated).
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: brand name shown to users (build time). Defaults to TechBeyond.
# NEXT_PUBLIC_BRAND_NAME=TechBeyond

# Optional contact details (build time). Defaults: ratsam93@gmail.com for general
# enquiries and role mailboxes on techbeyondsolution.com. Phone and address are
# shown on the Contact page only when set.
# NEXT_PUBLIC_CONTACT_EMAIL=ratsam93@gmail.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@techbeyondsolution.com
# NEXT_PUBLIC_CAREERS_EMAIL=careers@techbeyondsolution.com
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@techbeyondsolution.com
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_ADDRESS=
