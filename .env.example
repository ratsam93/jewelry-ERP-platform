# Copy to .env and replace every "change-me" value before first run.
# docker-compose requires MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, REDIS_PASSWORD,
# MEILI_MASTER_KEY, MINIO_ROOT_USER and MINIO_ROOT_PASSWORD to be set.

# ─── Database (MySQL) ───────────────────────────────────────────
# Keep these in sync with the compose passwords below.
DATABASE_URL="mysql://caratflow:change-me-mysql-app@localhost:3306/caratflow"
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=caratflow
MYSQL_USER=caratflow
MYSQL_PASSWORD=change-me-mysql-app

# ─── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis
REDIS_URL="redis://:change-me-redis@localhost:6379"

# ─── Auth / JWT ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET="replace-with-output-of-openssl-rand-hex-48"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Never enable in production.
ALLOW_DEV_OTP=false

# ─── Webhooks ───────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
BNPL_WEBHOOK_SECRET="replace-with-openssl-rand-hex-32"
HARDWARE_WEBHOOK_SECRET="replace-with-openssl-rand-hex-32"

# ─── Meilisearch ────────────────────────────────────────────────
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="change-me-meili-master-key"

# ─── MinIO / S3 ─────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ACCESS_KEY="change-me-minio-user"
S3_SECRET_KEY="change-me-minio-password"
S3_BUCKET="caratflow"
S3_REGION="us-east-1"

# ─── App ────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
# Set to "true" only behind a trusted reverse proxy.
TRUST_PROXY=false
# Swagger UI is disabled unless explicitly enabled.
SWAGGER_ENABLED=false
# Global rate limit: max requests per IP per window (default 100) and window length in ms (default 60000).
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3003"

# ─── Frontends ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Tenant the storefront reads from (x-tenant-id). Default in code is the seeded demo tenant (sharma-jewellers).
# Tenant ids differ per database; set this to the id of your tenant after seeding.
NEXT_PUBLIC_TENANT_ID="69544f8e-fa3c-40b4-8975-643825600ce7"
# Demo hint on login pages. Keep false outside demos.
NEXT_PUBLIC_DEMO_MODE=false
# Comma-separated extra image hosts allowed by the storefront (next/image).
NEXT_PUBLIC_IMAGE_HOSTS="placehold.co"

# ─── Tooling ────────────────────────────────────────────────────
# Keep the Chromium sandbox enabled unless running in a container that requires otherwise.
PUPPETEER_NO_SANDBOX=false

# ─── Rate API (Gold/Silver prices) ─────────────────────────────
RATE_API_URL=""
RATE_API_KEY=""
