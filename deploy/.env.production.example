# CaratFlow production environment.
# Copy to /opt/caratflow/.env on the server (chmod 600) and replace EVERY value
# marked CHANGE-ME. Never commit the real file. See docs/DEPLOYMENT-DOCKER.md.
#
# NOTE: the NEXT_PUBLIC_* values are NOT read from this file. They are inlined
# into the web/storefront/website images at BUILD time, so they come from GitHub
# repository VARIABLES (Settings > Secrets and variables > Actions > Variables).
# They are documented at the bottom of this file for reference only.

# ---- Domain / TLS ------------------------------------------------------------
# Your root domain (no scheme, no trailing dot). DNS A records are required for:
#   DOMAIN, www.DOMAIN, app.DOMAIN, shop.DOMAIN, api.DOMAIN, files.DOMAIN
DOMAIN=example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# ---- Images (GHCR) -------------------------------------------------------------
# GitHub user/org that owns the repository, LOWERCASE.
GHCR_OWNER=your-github-user
# The deploy workflow overwrites this with the commit SHA it deploys.
IMAGE_TAG=latest

# ---- MySQL ---------------------------------------------------------------------
# Generate each password with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
# (avoid characters that need URL-escaping, because they are embedded in DATABASE_URL)
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password
MYSQL_DATABASE=caratflow
MYSQL_USER=caratflow
MYSQL_PASSWORD=CHANGE-ME-app-password
# DATABASE_URL is composed by docker-compose.prod.yml from the values above:
#   mysql://MYSQL_USER:MYSQL_PASSWORD@mysql:3306/MYSQL_DATABASE

# ---- Redis ---------------------------------------------------------------------
# openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
REDIS_PASSWORD=CHANGE-ME-redis-password
# REDIS_URL / REDIS_HOST are composed by docker-compose.prod.yml.

# ---- Auth ----------------------------------------------------------------------
# REQUIRED, at least 32 characters. The API refuses to start in production without it.
#   openssl rand -base64 48
JWT_SECRET=CHANGE-ME-at-least-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Webhook signing secrets (BNPL / hardware integrations). openssl rand -hex 32
BNPL_WEBHOOK_SECRET=CHANGE-ME-hex-32
HARDWARE_WEBHOOK_SECRET=CHANGE-ME-hex-32

# ---- CORS ----------------------------------------------------------------------
# Optional. Defaults to https://app.DOMAIN, https://shop.DOMAIN, https://DOMAIN and
# https://www.DOMAIN. Set only if you need a different list (comma separated).
# CORS_ORIGINS=https://app.example.com,https://shop.example.com,https://example.com,https://www.example.com

# ---- File storage (MinIO inside the stack, or any S3-compatible service) --------
# The MinIO and mc images are built from source by CI (docker/minio.Dockerfile, AGPL-3.0).
# MinIO admin login. The API uses it as its S3 key (S3_ACCESS_KEY_ID/SECRET are
# set from these two in docker-compose.prod.yml). openssl rand -hex 16 / -hex 32
MINIO_ROOT_USER=CHANGE-ME-minio-user
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-password-min-8-chars
S3_BUCKET=caratflow
S3_REGION=us-east-1
# Defaults to https://files.DOMAIN (Caddy proxies it to MinIO; containers resolve it
# to Caddy internally). Use your provider's endpoint if you switch to AWS S3 etc.
# S3_ENDPOINT=https://files.example.com

# ---- Optional hardening / tuning (leave commented for defaults) -----------------
# Rate limit: requests per IP per window (defaults 100 / 60000 ms).
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000
# Swagger UI is OFF by default. If you enable it you MUST also set both credentials.
# SWAGGER_ENABLED=true
# SWAGGER_USER=
# SWAGGER_PASSWORD=
# Set to "block" to refuse sales of items without a valid HUID (default: warn).
# HUID_ENFORCEMENT=warn

# ---- Optional integrations ------------------------------------------------------
# The platform works without any of these; each feature degrades gracefully (mock or
# disabled) until its keys are set. Uncomment and fill ONLY what you use (an empty
# value is not the same as unset). Restart with: docker compose up -d
#
# Online payments (storefront checkout, BNPL, digital gold) - Razorpay:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Other payment gateways (select with PAYMENT_GATEWAY_PROVIDER=razorpay|stripe|cashfree):
# PAYMENT_GATEWAY_PROVIDER=razorpay
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_ENV=PROD
# KYC / PAN / bank verification - Cashfree Verify:
# CASHFREE_VERIFY_CLIENT_ID=
# CASHFREE_VERIFY_CLIENT_SECRET=
# GST e-invoice / e-way bill - Masters India:
# MASTERS_INDIA_CLIENT_ID=
# MASTERS_INDIA_CLIENT_SECRET=
# MASTERS_INDIA_USERNAME=
# MASTERS_INDIA_PASSWORD=
# MASTERS_INDIA_GSTIN=
# OTP / WhatsApp messaging:
# OTP_CHANNEL=WHATSAPP
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Push notifications:
# FCM_SERVER_KEY=
# Shipping - Shiprocket:
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# Shopify sync webhook:
# SHOPIFY_WEBHOOK_SECRET=
# Live gold/silver rates:
# RATE_PROVIDER=manual
# RATE_API_URL=
# RATE_API_KEY=
# METALS_DEV_API_KEY=
# MCX_API_URL=
# MCX_API_KEY=
# Gemstone certificate lookup:
# GIA_API_URL=
# GIA_API_KEY=
# IGI_API_URL=
# IGI_API_KEY=
# Social sign-in (storefront):
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# FB_APP_ID=
# FB_APP_SECRET=

# ---- One-shot tool inputs (bootstrap-tenant) --------------------------------------
# Only set when you run:  docker compose --profile tools run --rm bootstrap-tenant
# Prefer passing them inline instead of storing the admin password here:
#   TENANT_NAME="My Jewellers" TENANT_SLUG=my-jewellers ADMIN_EMAIL=me@example.com \
#   ADMIN_PASSWORD='...' docker compose --profile tools run --rm bootstrap-tenant

# =================================================================================
# BUILD-TIME values (GitHub repository VARIABLES, not used on the server)
# =================================================================================
#   DEPLOY_ENABLED = true                       turns the deploy workflow on
#   DOMAIN         = example.com                same as above
#   TENANT_ID      = <uuid of your tenant>      storefront/website tenant (NEXT_PUBLIC_TENANT_ID)
#   TENANT_SLUG    = my-jewellers               storefront tenant slug (NEXT_PUBLIC_TENANT_SLUG)
#   Derived by the workflow: NEXT_PUBLIC_API_URL=https://api.$DOMAIN,
#   NEXT_PUBLIC_SITE_URL=https://$DOMAIN

# Optional branding (defaults to TechBeyond). BRAND_NAME is read by the API at runtime;
# NEXT_PUBLIC_BRAND_NAME is baked into the web/storefront/website images at build time.
# BRAND_NAME=TechBeyond
# NEXT_PUBLIC_BRAND_NAME=TechBeyond
